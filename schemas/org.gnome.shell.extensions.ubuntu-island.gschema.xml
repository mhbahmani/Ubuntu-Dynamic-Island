<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.ubuntu-island"
          path="/org/gnome/shell/extensions/ubuntu-island/">
    <key name="color-theme" type="s">
      <default>'graphite'</default>
      <choices><choice value="graphite"/><choice value="ocean"/><choice value="forest"/><choice value="ember"/></choices>
      <summary>Color theme</summary>
    </key>
    <key name="surface-opacity" type="i">
      <default>98</default>
      <range min="0" max="100"/>
      <summary>Background opacity percentage</summary>
    </key>
    <key name="surface-matte" type="i">
      <default>60</default>
      <range min="0" max="100"/>
      <summary>Matte tone percentage</summary>
      <description>Flattens the background gradient; opacity independently controls transparency.</description>
    </key>
    <key name="pill-show-title" type="b">
      <default>true</default>
      <summary>Show the track name in the notch</summary>
      <description>When disabled, the collapsed pill keeps only the play state icon.</description>
    </key>
    <key name="pill-order" type="as"><default>['media', 'weather', 'network', 'cpu', 'bluetooth']</default><summary>Collapsed indicator order</summary></key>
    <key name="pill-show-weather" type="b"><default>false</default><summary>Show weather in the collapsed notch</summary></key>
    <key name="pill-show-network" type="b"><default>false</default><summary>Show network rates in the collapsed notch</summary></key>
    <key name="pill-width" type="i">
      <default>170</default>
      <range min="150" max="210"/>
      <summary>Collapsed pill width</summary>
      <description>Width of the compact island in pixels.</description>
    </key>
    <key name="expanded-width" type="i">
      <default>440</default>
      <range min="380" max="480"/>
      <summary>Expanded card width</summary>
      <description>Width of the expanded island in pixels.</description>
    </key>
    <key name="animation-duration" type="i">
      <default>220</default>
      <range min="0" max="500"/>
      <summary>Animation duration</summary>
      <description>Morph animation duration in milliseconds; 0 disables it.</description>
    </key>
    <key name="disable-animations" type="b">
      <default>false</default>
      <summary>Disable animations</summary>
      <description>Force instant open/close regardless of system animation settings.</description>
    </key>
    <key name="hover-open" type="b">
      <default>false</default>
      <summary>Open on hover</summary>
      <description>Expand the island after hovering the pill. Click always works too.</description>
    </key>
    <key name="hover-open-delay" type="i">
      <default>180</default>
      <range min="100" max="1000"/>
      <summary>Hover open delay</summary>
      <description>Milliseconds of hovering before the island expands.</description>
    </key>
    <key name="hover-close-delay" type="i">
      <default>350</default>
      <range min="0" max="2000"/>
      <summary>Hover close delay</summary>
      <description>Grace period before the expanded island closes after the pointer leaves.</description>
    </key>
    <key name="metrics-interval" type="i">
      <default>2</default>
      <range min="1" max="10"/>
      <summary>Metrics sampling interval</summary>
      <description>Seconds between CPU/RAM/network samples.</description>
    </key>
    <key name="move-clock" type="b">
      <default>true</default>
      <summary>Move clock to the right</summary>
      <description>Move the notification/calendar button out of the panel center for the island.</description>
    </key>
    <key name="enable-media" type="b">
      <default>true</default>
      <summary>Media controls</summary>
      <description>Show the now-playing section.</description>
    </key>
    <key name="enable-metrics" type="b">
      <default>true</default>
      <summary>System metrics</summary>
      <description>Show CPU, RAM, and network meters.</description>
    </key>
    <key name="enable-audio" type="b">
      <default>true</default>
      <summary>Audio controls</summary>
      <description>Show volume and output device selection.</description>
    </key>
    <key name="enable-bluetooth" type="b">
      <default>true</default>
      <summary>Bluetooth controls</summary>
      <description>Show paired devices and the adapter power toggle.</description>
    </key>
    <key name="enable-remote-art" type="b">
      <default>true</default>
      <summary>Fetch remote album art</summary>
      <description>Download HTTP(S) artwork through a bounded, host-checked, disk-cached request.</description>
    </key>
    <key name="enable-commute" type="b"><default>false</default><summary>Enable Commute</summary></key>
    <key name="commute-routes" type="s"><default>'[]'</default><summary>Saved driving routes</summary></key>
    <key name="commute-selected" type="s"><default>''</default><summary>Selected driving route</summary></key>
    <key name="commute-provider" type="s"><default>'auto'</default><choices><choice value="auto"/><choice value="neshan"/><choice value="mapbox"/><choice value="ors"/><choice value="graphhopper"/><choice value="fossgis"/><choice value="osrm"/></choices><summary>Preferred routing provider</summary></key>
    <key name="commute-interval" type="i"><default>15</default><range min="10" max="120"/><summary>Driving estimate refresh interval in minutes</summary></key>
    <key name="commute-fallback" type="b"><default>true</default><summary>Try backup routing providers</summary></key>
    <key name="commute-keys-revision" type="i"><default>0</default><summary>Credential change notification</summary></key>
    <key name="preferences-page" type="s"><default>'appearance'</default><summary>Requested settings page</summary></key>
    <key name="enable-weather" type="b"><default>false</default><summary>Enable Weather</summary></key>
    <key name="weather-location" type="s"><default>''</default><summary>Confirmed weather location as JSON</summary></key>
    <key name="weather-units" type="s"><default>'celsius'</default><choices><choice value="celsius"/><choice value="fahrenheit"/></choices><summary>Temperature units</summary></key>
    <key name="weather-provider" type="s"><default>'open-meteo'</default><choices><choice value="open-meteo"/><choice value="wttr"/></choices><summary>Preferred weather source with automatic fallback</summary></key>
    <key name="weather-motion" type="s"><default>'subtle'</default><choices><choice value="off"/><choice value="subtle"/><choice value="live"/></choices><summary>Weather scene motion</summary></key>
    <key name="pill-arrow-style" type="s"><default>'chevron'</default><choices><choice value="classic"/><choice value="compact"/><choice value="chevron"/></choices><summary>Network arrow shape in the collapsed notch</summary></key>
    <key name="pill-weather-style" type="s"><default>'colorful'</default><choices><choice value="colorful"/><choice value="minimal"/></choices><summary>Weather icon style in the collapsed notch</summary></key>
    <key name="pill-arrow-angle" type="i"><default>80</default><range min="40" max="120"/><summary>Chevron tip angle in degrees</summary></key>
    <key name="pill-show-commute" type="b"><default>false</default><summary>Show selected Commute estimate in the collapsed notch</summary></key>
    <key name="expand-tab" type="s">
      <default>'last'</default>
      <choices><choice value="last"/><choice value="media"/><choice value="system"/><choice value="audio"/><choice value="bluetooth"/><choice value="weather"/><choice value="commute"/></choices>
      <summary>Tab to show when expanding the island</summary>
      <description>Last keeps the previous tab. An unavailable preferred tab falls back to the last available tab.</description>
    </key>
  </schema>
</schemalist>
