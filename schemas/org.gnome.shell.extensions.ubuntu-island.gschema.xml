<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.ubuntu-island"
          path="/org/gnome/shell/extensions/ubuntu-island/">
    <key name="color-theme" type="s">
      <default>'graphite'</default>
      <choices><choice value="graphite"/><choice value="ocean"/><choice value="forest"/><choice value="ember"/></choices>
      <summary>Color theme</summary>
    </key>
    <key name="surface-opacity" type="i">
      <default>98</default>
      <range min="0" max="100"/>
      <summary>Background opacity percentage</summary>
    </key>
    <key name="surface-matte" type="i">
      <default>60</default>
      <range min="0" max="100"/>
      <summary>Matte tone percentage</summary>
      <description>Flattens the background gradient; opacity independently controls transparency.</description>
    </key>
    <key name="pill-title-mode" type="s"><default>'fixed'</default><choices><choice value="fixed"/><choice value="scroll"/><choice value="fit"/></choices><summary>Collapsed media title behavior</summary></key>
    <key name="pill-title-characters" type="i"><default>12</default><range min="5" max="40"/><summary>Character limit for fixed media titles</summary></key>
    <key name="pill-show-title" type="b">
      <default>true</default>
      <summary>Show the track name in the notch</summary>
      <description>When disabled, the collapsed pill keeps only the play state icon.</description>
    </key>
    <key name="pill-order" type="as"><default>['media', 'weather', 'network', 'cpu', 'bluetooth']</default><summary>Collapsed indicator order</summary></key>
    <key name="pill-show-weather" type="b"><default>false</default><summary>Show weather in the collapsed notch</summary></key>
    <key name="pill-show-network" type="b"><default>false</default><summary>Show network rates in the collapsed notch</summary></key>
    <key name="pill-show-date" type="b"><default>false</default><summary>Show today's date in the collapsed notch</summary></key>
    <key name="pill-date-calendar" type="s">
      <default>'main'</default>
      <choices><choice value="main"/><choice value="jalali"/><choice value="gregorian"/><choice value="hijri"/></choices>
      <summary>Legacy single notch calendar, migrated to pill-date-calendars</summary>
    </key>
    <key name="pill-date-calendars" type="as"><default>['jalali']</default><summary>Calendars shown in the notch; initialized to the main calendar</summary></key>
    <key name="pill-date-order" type="as"><default>['jalali', 'gregorian', 'hijri']</default><summary>Left-to-right order of notch dates</summary></key>
    <key name="pill-date-formats" type="a{ss}"><default>{}</default><summary>Per-calendar date formats; defaults to %d %mm</summary></key>
    <key name="pill-date-digits" type="a{ss}"><default>{}</default><summary>Per-calendar numerals: auto, persian, or latin</summary></key>
    <key name="pill-offline-mode" type="s">
      <default>'icon'</default>
      <choices><choice value="icon"/><choice value="edge"/><choice value="hide"/><choice value="badge"/></choices>
      <summary>Collapsed notch behavior without internet access</summary>
      <description>Show a connection icon, an unplugged icon with a broken bottom edge, or hide missing and stale indicators while keeping fresh cached values. Legacy badge values migrate to icon.</description>
    </key>
    <key name="pill-width" type="i">
      <default>170</default>
      <range min="150" max="210"/>
      <summary>Collapsed pill width</summary>
      <description>Width of the compact island in pixels.</description>
    </key>
    <key name="expanded-width" type="i">
      <default>440</default>
      <range min="380" max="480"/>
      <summary>Expanded card width</summary>
      <description>Width of the expanded island in pixels.</description>
    </key>
    <key name="animation-duration" type="i">
      <default>220</default>
      <range min="0" max="500"/>
      <summary>Animation duration</summary>
      <description>Morph animation duration in milliseconds; 0 disables it.</description>
    </key>
    <key name="disable-animations" type="b">
      <default>false</default>
      <summary>Disable animations</summary>
      <description>Force instant open/close regardless of system animation settings.</description>
    </key>
    <key name="hover-open" type="b">
      <default>false</default>
      <summary>Open on hover</summary>
      <description>Expand the island after hovering the pill. Click always works too.</description>
    </key>
    <key name="hover-open-delay" type="i">
      <default>180</default>
      <range min="100" max="1000"/>
      <summary>Hover open delay</summary>
      <description>Milliseconds of hovering before the island expands.</description>
    </key>
    <key name="hover-close-delay" type="i">
      <default>350</default>
      <range min="0" max="2000"/>
      <summary>Hover close delay</summary>
      <description>Grace period before the expanded island closes after the pointer leaves.</description>
    </key>
    <key name="metrics-interval" type="i">
      <default>2</default>
      <range min="1" max="10"/>
      <summary>Metrics sampling interval</summary>
      <description>Seconds between CPU/RAM/network samples.</description>
    </key>
    <key name="move-clock" type="b">
      <default>true</default>
      <summary>Move clock to the right</summary>
      <description>Move the notification/calendar button out of the panel center for the island.</description>
    </key>
    <key name="enable-media" type="b">
      <default>true</default>
      <summary>Media controls</summary>
      <description>Show the now-playing section.</description>
    </key>
    <key name="enable-calendar" type="b">
      <default>false</default>
      <summary>Jalali, Gregorian and Hijri calendar</summary>
    </key>
    <key name="calendar-mode" type="s">
      <default>'both'</default>
      <choices><choice value="both"/><choice value="jalali"/><choice value="gregorian"/></choices>
      <summary>Legacy calendar display mode, migrated to primary and additional calendars</summary>
    </key>
    <key name="calendar-primary" type="s">
      <default>'jalali'</default>
      <choices><choice value="jalali"/><choice value="gregorian"/><choice value="hijri"/></choices>
      <summary>Calendar used for the month grid</summary>
    </key>
    <key name="calendar-additional" type="as">
      <default>['gregorian']</default>
      <summary>Additional calendars for the selected date</summary>
    </key>
    <key name="enable-metrics" type="b">
      <default>true</default>
      <summary>System metrics</summary>
      <description>Show CPU, RAM, and network meters.</description>
    </key>
    <key name="enable-audio" type="b">
      <default>true</default>
      <summary>Audio controls</summary>
      <description>Show volume and output device selection.</description>
    </key>
    <key name="enable-bluetooth" type="b">
      <default>true</default>
      <summary>Bluetooth controls</summary>
      <description>Show paired devices and the adapter power toggle.</description>
    </key>
    <key name="enable-remote-art" type="b">
      <default>true</default>
      <summary>Fetch remote album art</summary>
      <description>Download HTTP(S) artwork through a bounded, host-checked, disk-cached request.</description>
    </key>
    <key name="enable-commute" type="b"><default>false</default><summary>Enable Commute</summary></key>
    <key name="commute-routes" type="s"><default>'[]'</default><summary>Saved driving routes</summary></key>
    <key name="commute-selected" type="s"><default>''</default><summary>Selected driving route</summary></key>
    <key name="commute-provider-order" type="as"><default>['balad', 'mapbox', 'neshan', 'ors', 'graphhopper', 'fossgis', 'osrm']</default><summary>Routing provider priority, first to last</summary></key>
    <key name="commute-open-with" type="s"><default>'google'</default><choices><choice value="google"/><choice value="balad"/><choice value="neshan"/></choices><summary>Map app used by Open route</summary></key>
    <key name="commute-provider" type="s"><default>'auto'</default><choices><choice value="auto"/><choice value="neshan"/><choice value="mapbox"/><choice value="balad"/><choice value="ors"/><choice value="graphhopper"/><choice value="fossgis"/><choice value="osrm"/></choices><summary>Preferred routing provider</summary></key>
    <key name="commute-interval" type="i"><default>15</default><range min="10" max="120"/><summary>Driving estimate refresh interval in minutes</summary></key>
    <key name="commute-fallback" type="b"><default>true</default><summary>Try backup routing providers</summary></key>
    <key name="commute-keys-revision" type="i"><default>0</default><summary>Credential change notification</summary></key>
    <key name="preferences-page" type="s"><default>'appearance'</default><summary>Requested settings page</summary></key>
    <key name="enable-weather" type="b"><default>false</default><summary>Enable Weather</summary></key>
    <key name="weather-location" type="s"><default>''</default><summary>Confirmed weather location as JSON</summary></key>
    <key name="weather-units" type="s"><default>'celsius'</default><choices><choice value="celsius"/><choice value="fahrenheit"/></choices><summary>Temperature units</summary></key>
    <key name="weather-provider" type="s"><default>'open-meteo'</default><choices><choice value="open-meteo"/><choice value="met"/><choice value="wttr"/></choices><summary>Preferred weather source with automatic fallback</summary></key>
    <key name="weather-motion" type="s"><default>'subtle'</default><choices><choice value="off"/><choice value="subtle"/><choice value="live"/></choices><summary>Weather scene motion</summary></key>
    <key name="pill-arrow-style" type="s"><default>'chevron'</default><choices><choice value="classic"/><choice value="compact"/><choice value="chevron"/></choices><summary>Network arrow shape in the collapsed notch</summary></key>
    <key name="pill-weather-style" type="s"><default>'colorful'</default><choices><choice value="colorful"/><choice value="minimal"/></choices><summary>Weather icon style in the collapsed notch</summary></key>
    <key name="pill-arrow-angle" type="i"><default>80</default><range min="40" max="120"/><summary>Chevron tip angle in degrees</summary></key>
    <key name="pill-show-commute" type="b"><default>false</default><summary>Show selected Commute estimate in the collapsed notch</summary></key>
    <key name="expand-tab" type="s">
      <default>'last'</default>
      <choices><choice value="last"/><choice value="media"/><choice value="system"/><choice value="audio"/><choice value="bluetooth"/><choice value="weather"/><choice value="commute"/><choice value="agents"/><choice value="calendar"/></choices>
      <summary>Tab to show when expanding the island</summary>
      <description>Last keeps the previous tab. An unavailable preferred tab falls back to the last available tab.</description>
    </key>
    <key name="island-toggle-shortcut" type="as"><default>['&lt;Super&gt;&lt;Alt&gt;i']</default><summary>Open or close the island</summary></key>
    <key name="island-next-tab-shortcut" type="as"><default>['&lt;Super&gt;&lt;Alt&gt;Right']</default><summary>Next available island tab</summary></key>
    <key name="island-previous-tab-shortcut" type="as"><default>['&lt;Super&gt;&lt;Alt&gt;Left']</default><summary>Previous available island tab</summary></key>
    <key name="island-quick-ask-shortcut" type="as"><default>[]</default><summary>Keyboard shortcut for the compact Quick Ask prompt</summary></key>
    <key name="enable-agents" type="b"><default>false</default><summary>enable agents</summary></key>
    <key name="pill-show-agents" type="b"><default>true</default><summary>pill show agents</summary></key>
    <key name="agents-notify" type="b"><default>false</default><summary>agents notify</summary></key>
    <key name="agents-inactive-minutes" type="i"><default>60</default><range min="1" max="10080"/><summary>Remove inactive sessions after this many minutes, checked when Agents opens</summary></key>
    <key name="agents-provider" type="s"><default>'claude'</default><choices><choice value="claude"/><choice value="codex"/><choice value="opencode"/></choices><summary>agents provider</summary></key>
    <key name="agents-terminal" type="s"><default>'auto'</default><choices><choice value="auto"/><choice value="gnome-terminal"/><choice value="kgx"/><choice value="terminator"/><choice value="kitty"/><choice value="wezterm"/></choices><summary>Terminal for agent sessions; auto follows the desktop default</summary></key>
    <key name="agents-terminal-default-migrated" type="b"><default>false</default><summary>Legacy automatic terminal selection migrated</summary></key>
    <key name="agents-project" type="s"><default>''</default><summary>agents project</summary></key>
    <key name="agents-opencode-major" type="s"><default>'1'</default><choices><choice value="1"/><choice value="2"/></choices><summary>agents opencode major</summary></key>
    <key name="agents-claude-config" type="s"><default>''</default><summary>agents claude config</summary></key>
    <key name="agents-claude-executable" type="s"><default>''</default><summary>agents claude executable</summary></key>
    <key name="agents-codex-config" type="s"><default>''</default><summary>agents codex config</summary></key>
    <key name="agents-codex-executable" type="s"><default>''</default><summary>agents codex executable</summary></key>
    <key name="agents-opencode-config" type="s"><default>''</default><summary>agents opencode config</summary></key>
    <key name="agents-opencode-executable" type="s"><default>''</default><summary>agents opencode executable</summary></key>
    <!-- Keep retired keys readable by Shell's cached pre-upgrade JavaScript until
         logout. Current code does not use these or expose their former controls. -->
    <key name="agents-destination" type="s"><default>'terminal'</default><choices><choice value="terminal"/><choice value="copy-terminal"/><choice value="desktop"/><choice value="web"/></choices><summary>Deprecated agent destination (upgrade compatibility)</summary></key>
    <key name="agents-claude-desktop" type="s"><default>''</default><summary>Deprecated Claude desktop app (upgrade compatibility)</summary></key>
    <key name="agents-codex-desktop" type="s"><default>''</default><summary>Deprecated Codex desktop app (upgrade compatibility)</summary></key>
    <key name="agents-opencode-desktop" type="s"><default>''</default><summary>Deprecated OpenCode desktop app (upgrade compatibility)</summary></key>
  </schema>
</schemalist>
